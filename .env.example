# Supabase client-side values
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxx

# Server-side only. Never prefix this with VITE_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxx

# Secret for /api/cron-dispatch
CRON_SECRET=replace-with-random-string

# v2.1 normally uses per-user webhook_url stored in scheduled_notifications.
# Optional fallback for legacy scheduled notifications.
DISCORD_WEBHOOK_URL=

# v2.3 Web Push / PWAスマホ通知
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
